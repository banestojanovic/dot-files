# ----- Homebrew & shell environment -----
if [[ -d /opt/homebrew/bin ]]; then
  export HOMEBREW_PREFIX=/opt/homebrew
fi

export STARSHIP_CONFIG="$HOME/Code/dotfiles/starship.toml"
eval "$(starship init zsh)"

# ----- Node.js -----
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env --use-on-cd --shell zsh)"

# ----- Tools -----
alias ls="eza --color=auto --long --git --no-filesize --icons=always --no-time --no-user --no-permissions"
source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
export PATH="$HOME/Code/dotfiles/scripts:$HOME/.local/bin:$HOME/.bun/bin:$HOME/.config/composer/vendor/bin:$PATH"
export PATH="$PATH:$HOME/Library/Android/sdk/emulator:$HOME/Library/Android/sdk/platform-tools"
export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
export ANDROID_HOME="$HOME/Library/Android/sdk"

# ----- Shortcuts -----
alias pint="vendor/bin/pint"
alias pest="vendor/bin/pest"
alias python="/opt/homebrew/bin/python3"
alias code="cd ~/Code"
alias art="php artisan"
alias dep="vendor/bin/dep"
alias dotfiles="cd ~/Code/dotfiles"

# ----- Functions -----
dust() {
  local msg="${1:-wip $(date '+%Y-%m-%d %H:%M:%S')}"
  git add . && git commit -m "$msg" && git push
}

# Pick a project and open it in the current Rex terminal session.
t() {
  local selected
  selected="$(command t "$@")" || return
  [[ -n "$selected" ]] && builtin cd -- "$selected"
}

y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

export PATH="$HOME/.local/bin:$PATH"
