#!/usr/bin/env bash

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$HOME/.config" "$HOME/.local/bin"

# Preserve user-specific shell functions and load the shared shell config.
touch "$HOME/.zshrc"
if [[ ! -L "$HOME/.zshrc" || "$(readlink "$HOME/.zshrc")" != "$DOTFILES/zsh/zshrc" ]] && \
    ! grep -Fq "source \"$DOTFILES/zsh/zshrc\"" "$HOME/.zshrc"; then
    printf '\n# Load the shared dotfiles shell configuration.\nsource "%s/zsh/zshrc"\n' "$DOTFILES" >> "$HOME/.zshrc"
fi

# Keep the existing Ghostty setup and share its configuration.
if [[ -L "$HOME/.config/ghostty" || ! -e "$HOME/.config/ghostty" ]]; then
    ln -sfn "$DOTFILES/ghostty" "$HOME/.config/ghostty"
fi

# Starship prompt
if [[ -L "$HOME/.config/starship.toml" || ! -e "$HOME/.config/starship.toml" ]]; then
    ln -sfn "$DOTFILES/starship.toml" "$HOME/.config/starship.toml"
fi

# Project picker
ln -sf "$DOTFILES/scripts/t" "$HOME/.local/bin/t"
