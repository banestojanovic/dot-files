#!/usr/bin/env bash

# Print a selected project path. The zsh function named `t` changes the
# current shell's directory to this result, keeping the current Rex session.
if [[ $# -gt 0 ]]; then
    selected=$1
else
    selected=$(
        {
            find "$HOME/Code" -maxdepth 2 -mindepth 1 -type d -print 2>/dev/null
            if [[ -d "$HOME/Code/wp" ]]; then
                find "$HOME/Code/wp" -maxdepth 3 -type d \
                    \( -path '*/wp-content/themes' -o -path '*/wp-content/plugins' \) \
                    -prune -exec find {} -mindepth 1 -maxdepth 1 -type d -print \; 2>/dev/null |
                    while IFS= read -r path; do
                        if [[ "$path" == */wp-content/themes/* ]]; then
                            printf '%s\t%s-theme\n' "$path" "${path##*/}"
                        else
                            printf '%s\n' "$path"
                        fi
                    done
            fi
            printf '%s\n' /tmp
        } | fzf --delimiter=$'\t' --with-nth=1,2 --height=40% --layout=reverse
    )
    selected=${selected%%$'\t'*}
fi

[[ -n "$selected" ]] || exit 1
printf '%s\n' "$selected"
